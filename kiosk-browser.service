[Unit]
Description=Kiosk Chromium browser for sensor dashboard
After=graphical.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
ExecStart=/home/pi/dashboard_fix/start_kiosk.sh
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
